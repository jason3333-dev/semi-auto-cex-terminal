# Copy to .env.session for local session persistence.
# .env.session is ignored by Git. Edit it directly and restart the server.

# Default exchange: MemeMax Orderly perps.
SESSION_EXCHANGE_ID=mememax-orderly

# Valid values: dry-run, testnet, live
# Keep dry-run until docs/validation.md passes. Testnet requires at least:
# SESSION_EXCHANGE_ID, TRADING_MODE=testnet, MEMEMAX_ORDERLY_ACCOUNT_ID,
# and MEMEMAX_ORDERLY_SECRET. Live additionally requires the unlock phrase below.
TRADING_MODE=dry-run

# MemeMax Orderly credentials.
# MEMEMAX_ORDERLY_KEY may be omitted when it can be derived from the secret.
MEMEMAX_ORDERLY_ACCOUNT_ID=
MEMEMAX_ORDERLY_KEY=
MEMEMAX_ORDERLY_SECRET=
MEMEMAX_ORDER_TAG=
MEMEMAX_ORDERLY_BASE_URL=
MEMEMAX_ORDERLY_TESTNET_BASE_URL=
MEMEMAX_ORDERLY_PUBLIC_WS_BASE_URL=
MEMEMAX_ORDERLY_TESTNET_PUBLIC_WS_BASE_URL=
MEMEMAX_ORDERLY_PRIVATE_WS_BASE_URL=
MEMEMAX_ORDERLY_TESTNET_PRIVATE_WS_BASE_URL=

# MemeMax chase defaults. UI intentionally stays minimal; edit these and restart.
MEMEMAX_CHASE_MIN_UPDATE_MS=100
MEMEMAX_CHASE_UPDATE_MS=100
MEMEMAX_CHASE_RATE_LIMIT_10S_ORDERS=100
MEMEMAX_CHASE_RATE_LIMIT_SAFETY=1
MEMEMAX_CHASE_RATE_LIMIT_WINDOW_MS=1000
MEMEMAX_CHASE_ORDER_OPS_PER_REPLACE=1
MEMEMAX_CHASE_REST_FALLBACK_UPDATE_MS=1000
MEMEMAX_CHASE_STATUS_CHECK_MS=1000
MEMEMAX_CHASE_STATUS_POLL_WITH_PRIVATE_STREAM=false

# MemeMax positional TP/SL algo guardrails.
MEMEMAX_ALGO_RATE_LIMIT_10S_ORDERS=10
MEMEMAX_ALGO_RATE_LIMIT_WINDOW_MS=1000
MEMEMAX_ALGO_RATE_LIMIT_SAFETY=1

# Order defaults.
ORDER_POST_ONLY=true
CHASE_POST_ONLY=true
CHASE_TICK_OFFSET=0
CHASE_MAX_REPLACES=240

# Generic chase fallback values for non-MemeMax adapters.
CHASE_MIN_UPDATE_MS=500
CHASE_UPDATE_MS=500
CHASE_RATE_LIMIT_10S_ORDERS=300
CHASE_RATE_LIMIT_SAFETY=0.7

# Account refresh and Orderly private stream fallback/reconnect.
ACCOUNT_REFRESH_MS=1000
ACCOUNT_STREAM_ENABLED=true
ACCOUNT_STREAM_KEEPALIVE_MS=3000000
ACCOUNT_STREAM_RECONNECT_MS=5000

# Chart indicators.
CHART_VWAP_ENABLED=true
CHART_VWAP_PERIOD=80

# Optional backoff/rate-limit guardrails.
# CHASE_MAX_BACKOFF_MS=30000
# CHASE_MAX_TRANSIENT_ERRORS=8
# CHASE_RETRY_PAD_MS=750
# CHASE_ORDER_OPS_PER_REPLACE=2

# Optional Binance adapter. Only used when SESSION_EXCHANGE_ID=binance-usdm.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_ACCOUNT_MODE=portfolio
BINANCE_POSITION_MODE=hedge
BINANCE_MARGIN_MODE=cross

# Live-mode risk guardrails. Scoped variants such as MEMEMAX_LIVE_MAX_NOTIONAL
# or BINANCE_LIVE_MAX_LEVERAGE override these for the active exchange.
LIVE_MAX_NOTIONAL=100
LIVE_MAX_LEVERAGE=10
# LIVE_ALLOWED_SYMBOLS=BTCUSDC,ETHUSDC

# Required only if you deliberately persist live mode.
# LIVE_UNLOCK_PHRASE=I_ACCEPT_LIVE_RISK
